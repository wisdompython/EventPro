# Copy this file to .env and fill in your values

# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — set to 'postgresql' to switch away from SQLite.
# Note: this setting applies to runserver only. The test suite always uses
# PostgreSQL (matching production) unless you set TEST_DATABASE_ENGINE=sqlite.
DATABASE_ENGINE=sqlite

# PostgreSQL — matches the defaults in docker-compose.yml.
# Start it with: docker compose up -d postgres
DB_NAME=guest_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Transactional email - Mailtrap Email Sandbox SMTP credentials.
# Find these under Email Testing -> Sandboxes -> Integration -> SMTP.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=Event Pro <no-reply@eventpro.local>
PASSWORD_RESET_THROTTLE_RATE=5/hour
PASSWORD_RESET_TIMEOUT=3600

# WhatsApp — Meta Cloud API via PyWA
# Use "log" locally to simulate successful sends in backend/worker logs,
# or "meta" to send through the real WhatsApp Cloud API.
WHATSAPP_TRANSPORT=log
# Get these from Meta Business Manager → WhatsApp → API Setup
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=guest_management_verify
WHATSAPP_PASS_TEMPLATE=tws_guestpass

# Optional public base URL for pass-image delivery, e.g. https://yourdomain.com
# Leave blank locally: Event Pro uploads image bytes directly to Meta.
WHATSAPP_MEDIA_BASE_URL=

# RSVP abuse and reminder safeguards
PUBLIC_RSVP_THROTTLE_RATE=30/min
RSVP_REMINDER_COOLDOWN_MINUTES=360
RSVP_MAX_REMINDERS=3
