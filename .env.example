# Event Pro local Docker defaults. Copy this file to .env only when you
# want to override a value; docker compose works with these defaults as-is.
DB_NAME=guest_management
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432
REDIS_PORT=6379
APP_TIME_ZONE=Africa/Lagos
SECRET_KEY=replace-for-any-shared-environment
EVENT_PRO_DEMO_USERNAME=eventpro-demo
EVENT_PRO_DEMO_PASSWORD=eventpro123
EVENT_PRO_DEMO_EMAIL=admin@eventpro.local

# Password-reset email sandbox. Copy the SMTP credentials from Mailtrap.
MAILTRAP_SMTP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USERNAME=
MAILTRAP_SMTP_PASSWORD=
MAILTRAP_SMTP_USE_TLS=True
DEFAULT_FROM_EMAIL=Event Pro <no-reply@eventpro.local>
PASSWORD_RESET_TIMEOUT=3600

# WhatsApp has its own transport; Mailtrap does not receive WhatsApp messages.
# "log" simulates sends locally. Use "meta" with the credentials below for real delivery.
WHATSAPP_TRANSPORT=log
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=guest_management_verify
WHATSAPP_PASS_TEMPLATE=event_pass_delivery
# Optional in local development; blank uses direct image upload to Meta.
WHATSAPP_MEDIA_BASE_URL=
